rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function admin() {
      return logado() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    // lista de administradores: cada um só confirma o próprio; ninguém grava pelo app (só pelo console)
    match /admins/{email} {
      allow get: if logado() && request.auth.token.email.lower() == email;
    }
    match /users/{uid}/{document=**} {
      allow read, write: if logado() && request.auth.uid == uid;
    }
    // e-mails com acesso completo: a pessoa só consegue ver o próprio; só o administrador grava
    match /liberados/{email} {
      allow get: if admin() || (logado() && request.auth.token.email.lower() == email);
      allow list, write: if admin();
    }
    // pedidos de Pro: a pessoa cria/atualiza só o próprio pedido; o administrador vê, autoriza e apaga
    match /solicitacoes/{email} {
      allow get: if admin() || (logado() && request.auth.token.email.lower() == email);
      allow create, update: if logado() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email && request.resource.data.email == email;
      allow list, delete: if admin();
    }
    // 📊 visitas: cada aparelho registra a própria visita do dia (sem dados pessoais); só o administrador lê
    match /acessos/{dia}/aparelhos/{aparelho} {
      allow create, update: if dia.size() == 10 && aparelho.size() < 40
        && request.resource.data.keys().hasOnly(['aberturas', 'ultimo', 'logado'])
        && request.resource.data.aberturas is int && request.resource.data.aberturas <= 500
        && request.resource.data.ultimo is int && request.resource.data.logado is bool;
      allow read: if admin();
    }
    // 📊 contas: cada pessoa grava só a própria (com o e-mail verdadeiro do login); só o administrador lista
    match /contas/{uid} {
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['nome', 'email', 'foto', 'primeiro', 'ultimo', 'acessos']);
      allow get: if admin() || (logado() && request.auth.uid == uid);
      allow list: if admin();
    }
    // 💬 feedback: qualquer pessoa envia (logada só com o próprio e-mail/uid); só o administrador lê, marca como lido e apaga
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'texto', 'uid', 'email', 'nome', 'contato', 'data', 'pagina', 'idioma', 'lido'])
        && request.resource.data.tipo in ['problema', 'ideia', 'outro']
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 3000
        && request.resource.data.contato is string && request.resource.data.contato.size() <= 100
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.data is int && request.resource.data.lido == false
        && (request.resource.data.uid == '' || (logado() && request.resource.data.uid == request.auth.uid))
        && (request.resource.data.email == '' || (logado() && request.resource.data.email == request.auth.token.email.lower()));
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lido']);
    }
    // ⚔️ duelos: quem cria é o dono; qualquer pessoa logada lê pelo link e grava SÓ o próprio resultado, uma vez
    match /duelos/{id} {
      allow create: if logado() && request.resource.data.criador == request.auth.uid
        && request.resource.data.keys().hasOnly(['criador', 'criadorNome', 'titulo', 'idioma', 'questoes', 'criado', 'resultados'])
        && request.resource.data.questoes is list && request.resource.data.questoes.size() <= 15
        && request.resource.data.resultados is map && request.resource.data.resultados.size() == 0
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 80;
      allow get: if logado();
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultados'])
        && request.resource.data.resultados.diff(resource.data.resultados).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in resource.data.resultados)
        && request.resource.data.resultados[request.auth.uid].keys().hasOnly(['nome', 'acertos', 'total', 'tempo', 'data', 'av'])
        && request.resource.data.resultados[request.auth.uid].acertos is int
        && request.resource.data.resultados[request.auth.uid].acertos <= request.resource.data.questoes.size();
      allow delete: if logado() && resource.data.criador == request.auth.uid;
    }
    // 🏆 ranking da semana: cada pessoa grava só a própria linha; quem está logado vê o ranking
    match /ranking/{semana}/pessoas/{uid} {
      allow create, update: if logado() && request.auth.uid == uid && semana.size() <= 10
        && request.resource.data.keys().hasOnly(['nome', 'av', 'turma', 'xp', 'atualizado'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 200000
        && request.resource.data.turma is string && request.resource.data.turma.size() <= 24
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 40;
      allow read: if logado();
    }
    // caminho até o pagamento: cada conta grava só o próprio (com o e-mail do login); sem login, só o número do aparelho, sem dados pessoais
    match /funil/{id} {
      function inteiro(k) { return request.resource.data.get(k, 0) is int; }
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'nome', 'ap', 'ultimo', 'viu', 'clicou', 'limite', 'qr', 'falhou', 'copiou', 'cartao', 'assinar', 'pediu'])
        && ((logado() && id == request.auth.uid && request.resource.data.email == request.auth.token.email.lower())
          || (id.matches('ap_[A-Za-z0-9-]{4,60}') && request.resource.data.ap == id && request.resource.data.email == '' && request.resource.data.nome == ''))
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.ap is string && request.resource.data.ap.size() <= 64
        && request.resource.data.ultimo is int && request.resource.data.get('viu', 0) is int && request.resource.data.get('viu', 0) <= 100000
        && inteiro('clicou') && inteiro('limite') && inteiro('qr') && inteiro('falhou')
        && inteiro('copiou') && inteiro('cartao') && inteiro('assinar') && inteiro('pediu');
      allow read, delete: if admin();
    }
    // chave Pix, WhatsApp, preço e limites do plano grátis: todos leem, só o administrador muda
    match /config/{doc} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
